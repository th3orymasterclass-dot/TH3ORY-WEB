{
  "alias": [
    "th3ory.online",
    "www.th3ory.online"
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/dpdp-consent",
      "destination": "/api/dpdp?action=consent"
    },
    {
      "source": "/api/dpdp-dsr",
      "destination": "/api/dpdp?action=dsr"
    },
    {
      "source": "/api/dpdp-export",
      "destination": "/api/dpdp?action=export"
    },
    {
      "source": "/api/dpdp-grievance",
      "destination": "/api/dpdp?action=grievance"
    },
    {
      "source": "/api/verify-stream-key",
      "destination": "/api/verify-certificate?action=stream-key"
    },
    {
      "source": "/api/update-student-profile",
      "destination": "/api/student-auth?action=update-profile"
    },
    {
      "source": "/api/sync-newsletter-sheets",
      "destination": "/api/sync-database-sheets?legacy=newsletter"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/|assets/|sitemap\\.xml|robots\\.txt|.*\\.(?:js|css|xml|txt|svg|png|jpg|jpeg|webp|ico|pem|json|pdf|woff|woff2|ttf|mp4|map)).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=3600, stale-while-revalidate=86400"
        },
        {
          "key": "X-Robots-Tag",
          "value": "all"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=3600, stale-while-revalidate=86400"
        },
        {
          "key": "X-Robots-Tag",
          "value": "all"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/bimi-logo.svg",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/svg+xml; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/bimi-vmc.pem",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/x-pem-file; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self' https://th3ory.online https://www.th3ory.online; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://checkout.razorpay.com https://assets.calendly.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://assets.calendly.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; media-src 'self' data: blob: https:; connect-src 'self' https://qngzfcpnjpabaornddau.supabase.co wss://qngzfcpnjpabaornddau.supabase.co https://api.razorpay.com https://assets.calendly.com https://*.vercel-storage.com https://script.google.com https://script.googleusercontent.com; frame-src 'self' https://api.razorpay.com https://calendly.com https://drive.google.com https://docs.google.com; frame-ancestors 'self'; object-src 'none'; base-uri 'self';"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(self 'https://api.razorpay.com')"
        }
      ]
    }
  ]
}
